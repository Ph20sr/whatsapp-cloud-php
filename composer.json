{
    "name": "ph20sr/whatsapp-cloud-php",
    "description": "Cliente PHP da WhatsApp Cloud API (Meta): texto, templates, mídia, botões e marcação de lida; webhook com verificação de assinatura e eventos tipados.",
    "type": "library",
    "license": "MIT",
    "keywords": ["whatsapp", "whatsapp-cloud-api", "meta", "webhook", "chatbot", "php"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "Ph20sr\\WhatsApp\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Ph20sr\\WhatsApp\\Tests\\": "tests/" }
    }
}
